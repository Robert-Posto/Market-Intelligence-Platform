# systemd — Marketing Command Center (mcc-test.libra.bank)
# Instalare: cp deploy/mcc.service /etc/systemd/system/ && systemctl enable --now mcc
# Serverul ascultă doar pe loopback (verify_request din app/server.py); din rețea
# se intră prin nginx (deploy/nginx-mcc.conf).
[Unit]
Description=Marketing Command Center (Libra Bank)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=marketing
Group=marketing
WorkingDirectory=/opt/marketing/mcc
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/marketing/venv/bin/python /opt/marketing/mcc/app/server.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
