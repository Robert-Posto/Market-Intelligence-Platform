# Copiaza in .env si completeaza. .env e in .gitignore si nu se versioneaza.

# Cheia Anthropic, folosita de discovery-ul LLM (claudeCrawl.py) si de
# extractia cu fallback LLM. NU se scrie niciodata in cod sau in loguri.
ANTHROPIC_API_KEY=sk-ant-...

# Sarea pentru pseudonimizarea autorilor de review-uri (app_review.autor_hash).
# Obligatorie: fara ea, hash-urile ar fi reversibile prin dictionar de nume.
MIP_SALT=schimba-asta

# Conexiunea la Postgres-ul din docker-compose.yml
MIP_DSN=host=localhost port=5432 dbname=mip user=mip password=mip
MIP_PORT=8765

# Rularile manuale din Overview (app/rulari.py). 1 = butoanele "Ruleaza"
# pornesc scripturile de colectare din lista fixa (BNR, YouTube, iOS, campanii,
# comunicate, Bing, preturi pe o banca, refacere din Bronze). DOAR pe laptopul
# care colecteaza; pe serverul comun ramane 0 si aplicatia e doar-citire.
MIP_PERMITE_RULARI=0

# Autentificarea cu Active Directory (app/autentificare.py). Valorile de mai jos
# sunt EXEMPLE fictive; pe server le dă IT-ul (vezi deploy/INSTALARE.md). Fără
# ele logarea răspunde 503 (ad_indisponibil), iar serverul scrie motivul la pornire.
# Doar ldaps:// (TLS, certificat verificat): pe ldap:// parola ar trece în clar.
MCC_LDAP_URL=ldaps://dc01.banca.example:636
# sufixul UPN: logarea se face ca <utilizator>@<domeniu>
MCC_LDAP_DOMENIU=banca.example
MCC_LDAP_BAZA=DC=banca,DC=example
# DN-urile celor două grupuri; contează și apartenența prin grupuri imbricate,
# iar cine e în ambele e admin
MCC_LDAP_GRUP_ADMIN=CN=MCC-Admin,OU=Grupuri,DC=banca,DC=example
MCC_LDAP_GRUP_ANALIST=CN=MCC-Analist,OU=Grupuri,DC=banca,DC=example
# CA-ul care a emis certificatul DC-ului (PEM); gol = depozitul sistemului
MCC_LDAP_CA=
# sesiunea expiră după atâtea ore fără activitate (și oricum după 12 h)
MCC_SESIUNE_ORE=8

# DOAR pe laptop: admin sau analist = intri cu acel rol fără logare (cererile
# venite prin nginx nu sunt niciodată locale). Pe server rămâne GOL: acolo
# mcc.service pune MCC_AUTH_OBLIGATORIE=1, iar cu MCC_AUTH_LOCAL setată
# serverul refuză să pornească.
MCC_AUTH_LOCAL=

# TikTok for Developers (Research API / Commercial Content API), folosite de
# ingest/tiktok_api.py. Din developers.tiktok.com/research/ -> proiectul aprobat
# -> Client key / Client secret. NU se scriu niciodata in cod, loguri sau output.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# YouTube Data API v3 (cheie API, fara OAuth), folosita de ingest/youtube_api.py.
# console.cloud.google.com -> proiect -> "YouTube Data API v3" activat ->
# Credentials -> API key, restrictionata la acest API. NU se scrie in cod,
# loguri sau output (jurnalul cererilor o mascheaza).
YOUTUBE_API_KEY=
