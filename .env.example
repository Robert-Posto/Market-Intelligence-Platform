# Copiaza in .env si completeaza. .env e in .gitignore si nu se versioneaza.

# Cheia Anthropic, folosita de discovery-ul LLM (claudeCrawl.py) si de
# extractia cu fallback LLM. NU se scrie niciodata in cod sau in loguri.
ANTHROPIC_API_KEY=sk-ant-...

# Sarea pentru pseudonimizarea autorilor de review-uri (app_review.autor_hash).
# Obligatorie: fara ea, hash-urile ar fi reversibile prin dictionar de nume.
MIP_SALT=schimba-asta

# Conexiunea la Postgres-ul din docker-compose.yml
MIP_DSN=host=localhost port=5432 dbname=mip user=mip password=mip
MIP_PORT=8765
