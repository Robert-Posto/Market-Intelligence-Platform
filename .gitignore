# secrete — nu intra niciodata in versionare
.env
*.key

# artefacte locale
__pycache__/
*.pyc
.cache_pdf/

# Bronze: octeții bruți descărcați de la bănci. NU se versionează.
# 107 MB / 298 de fișiere la prima rulare, și crește la fiecare colectare.
# Se reconstruiește rulând pipeline-ul; nu e cod și nu e rezultat, e materie
# primă. A ajuns o dată în commit din greșeală (lipsea din lista asta) și a
# umflat repo-ul la 33 MB.
bronze/

# ieșiri intermediare ale scripturilor
date/*.json
loguri/*.log

# spatiul de lucru al crawler-ului (PDF-uri descarcate, loguri); ce se incarca
# in baza e copiat explicit in date/pachet/
output/

# arhivele Bronze de la pornirile de la zero, jurnalele pe banci
bronze_arhiva_*/
loguri/banci/

# note de lucru și ledger-e locale (planuri, pauze, analize ale agenților)
.superpowers/

# copiile robots.txt scrise de ingest/flux.py la fiecare descărcare
# (<gazda>_<AAAA-LL-ZZTHHMM>.txt + .json): se adună la fiecare rulare și rămân
# pe mașina care a făcut cererile. Cele 30 de copii vechi (bcr.txt, ing.txt...)
# sunt deja versionate și rămân așa: .gitignore nu atinge fișierele urmărite.
date/robots/*_20??-??-??T*
# coada pe origine (lacăt + ora ultimei cereri), stare de rulare
loguri/origini/
# rulările manuale din Overview (app/rulari.py): jurnale, istoric, rularea curentă
loguri/rulari/

# dependențe npm (rădăcina și web/)
node_modules/
